#!/bin/sh
# /etc/shpun/router_updater
# Safe OTA updater for shpun-router

CONF_DIR="/etc/shpun"
SUB_FILE="$CONF_DIR/subscription.json"
CONFIG_URL_FILE="$CONF_DIR/router_config_url"
UPDATE_URL_FILE="$CONF_DIR/router_update_url"
UPDATE_MIN_VERSION_FILE="$CONF_DIR/router_min_version"

# новые имена (для ucode / виджета)
FW_CURRENT_FILE="$CONF_DIR/fw_current"
FW_LATEST_FILE="$CONF_DIR/fw_latest"

# старые имена (для совместимости)
LOCAL_VER_FILE="$CONF_DIR/router_software_version"
LOCAL_VER_FILE_LEGACY="$CONF_DIR/router_version"
LATEST_VER_FILE="$CONF_DIR/router_latest_version"

LOCAL_VER_PREV_FILE="$CONF_DIR/router_software_version.prev"
LOCK_FILE="/var/run/shpun-update.lock"

LOG_TAG="shpun-update"
PKG_NAME="shpun-router"

log() {
	logger -t "$LOG_TAG" "$*"
}

append_format_json() {
	local url="$1"

	case "$url" in
		*format=*) printf '%s' "$url" ;;
		*\?*)     printf '%s&format=json' "$url" ;;
		*)        printf '%s?format=json' "$url" ;;
	esac
}

json_value_from_sources() {
	local expr="$1"
	shift
	local src val

	for src in "$@"; do
		[ -s "$src" ] || continue
		val="$(jsonfilter -i "$src" -e "$expr" 2>/dev/null || echo "")"
		[ -n "$val" ] && {
			printf '%s' "$val"
			return 0
		}
	done

	return 1
}

file_value_from_sources() {
	local src val

	for src in "$@"; do
		[ -s "$src" ] || continue
		val="$(tr -d '\r\n ' < "$src" 2>/dev/null || echo "")"
		[ -n "$val" ] && {
			printf '%s' "$val"
			return 0
		}
	done

	return 1
}

version_part_num() {
	local part="$1"

	part="$(printf '%s' "$part" | sed 's/^[^0-9]*//; s/[^0-9].*$//' 2>/dev/null || echo "")"
	case "$part" in
		''|*[!0-9]*) echo 0 ;;
		*) echo "$part" ;;
	esac
}

# --- version compare ---
# ver_cmp A B -> echo:
#   0  если A < B
#   1  если A = B
#   2  если A > B
ver_cmp() {
	local v1="${1:-0.0.0}"
	local v2="${2:-0.0.0}"
	local oldifs a1 a2 a3 b1 b2 b3

	oldifs="$IFS"
	IFS=.
	set -- $v1
	a1="$(version_part_num "${1:-0}")"
	a2="$(version_part_num "${2:-0}")"
	a3="$(version_part_num "${3:-0}")"
	set -- $v2
	b1="$(version_part_num "${1:-0}")"
	b2="$(version_part_num "${2:-0}")"
	b3="$(version_part_num "${3:-0}")"
	IFS="$oldifs"

	[ "$a1" -lt "$b1" ] && { echo 0; return; }
	[ "$a1" -gt "$b1" ] && { echo 2; return; }

	[ "$a2" -lt "$b2" ] && { echo 0; return; }
	[ "$a2" -gt "$b2" ] && { echo 2; return; }

	[ "$a3" -lt "$b3" ] && { echo 0; return; }
	[ "$a3" -gt "$b3" ] && { echo 2; return; }

	echo 1
}

# --- lock ---
if [ -e "$LOCK_FILE" ]; then
	if kill -0 "$(cat "$LOCK_FILE" 2>/dev/null)" 2>/dev/null; then
		log "another update process is running"
		exit 1
	fi
fi
echo $$ >"$LOCK_FILE"
trap 'rm -f "$LOCK_FILE" "$META_FILE"' EXIT

# --- deps ---
for bin in jsonfilter uclient-fetch opkg; do
	if ! command -v "$bin" >/dev/null 2>&1; then
		log "dependency missing: $bin"
		exit 1
	fi
done

META_FILE=""
if [ -s "$CONFIG_URL_FILE" ]; then
	CONFIG_URL="$(tr -d '\r\n ' < "$CONFIG_URL_FILE" 2>/dev/null || echo "")"
	case "$CONFIG_URL" in
		http://*|https://*)
			META_FILE="/tmp/shpun-router-update-meta.json"
			if ! uclient-fetch -qO "$META_FILE" "$(append_format_json "$CONFIG_URL")" >/dev/null 2>&1; then
				log "router_config metadata refresh failed, using local subscription metadata"
				rm -f "$META_FILE"
				META_FILE=""
			fi
			;;
	esac
fi

# нам нужна только информация о router_software из subscription.json;
# если файла нет — просто ничего не делаем (не считаем это ошибкой привязки)
# --- read remote fields (поддержка двух имён блока) ---
REMOTE_VER="$(
	json_value_from_sources '@.router_software.version' "$META_FILE" \
	|| json_value_from_sources '@.router_software_current.version' "$META_FILE" \
	|| file_value_from_sources "$FW_LATEST_FILE" "$LATEST_VER_FILE" \
	|| json_value_from_sources '@.router_software.version' "$SUB_FILE" \
	|| json_value_from_sources '@.router_software_current.version' "$SUB_FILE" \
	|| echo ""
)"

UPDATE_URL="$(
	json_value_from_sources '@.router_software.update_url' "$META_FILE" \
	|| json_value_from_sources '@.router_software_current.update_url' "$META_FILE" \
	|| file_value_from_sources "$UPDATE_URL_FILE" \
	|| json_value_from_sources '@.router_software.update_url' "$SUB_FILE" \
	|| json_value_from_sources '@.router_software_current.update_url' "$SUB_FILE" \
	|| echo ""
)"

MIN_VER="$(
	json_value_from_sources '@.router_software.min_version' "$META_FILE" \
	|| json_value_from_sources '@.router_software_current.min_version' "$META_FILE" \
	|| file_value_from_sources "$UPDATE_MIN_VERSION_FILE" \
	|| json_value_from_sources '@.router_software.min_version' "$SUB_FILE" \
	|| json_value_from_sources '@.router_software_current.min_version' "$SUB_FILE" \
	|| echo ""
)"

case "$UPDATE_URL" in
	http://*|https://*) printf '%s\n' "$UPDATE_URL" >"$UPDATE_URL_FILE" ;;
	*) UPDATE_URL="" ;;
esac
[ -n "$REMOTE_VER" ] && {
	echo "$REMOTE_VER" >"$FW_LATEST_FILE"
	echo "$REMOTE_VER" >"$LATEST_VER_FILE"
}
[ -n "$MIN_VER" ] && echo "$MIN_VER" >"$UPDATE_MIN_VERSION_FILE"

# --- read local version (новые + старые имена) ---
LOCAL_VER=""
if [ -f "$FW_CURRENT_FILE" ]; then
	LOCAL_VER="$(tr -d '\r\n ' < "$FW_CURRENT_FILE")"
elif [ -f "$LOCAL_VER_FILE" ]; then
	LOCAL_VER="$(tr -d '\r\n ' < "$LOCAL_VER_FILE")"
elif [ -f "$LOCAL_VER_FILE_LEGACY" ]; then
	LOCAL_VER="$(tr -d '\r\n ' < "$LOCAL_VER_FILE_LEGACY")"
fi

log "start update check: local=${LOCAL_VER:-none}, remote=${REMOTE_VER:-none}, min=${MIN_VER:-none}"

# --- корректно обновляем latest-файлы с учётом сравнения версий ---
LATEST_EFFECTIVE=""

if [ -n "$REMOTE_VER" ] && [ -n "$LOCAL_VER" ]; then
	cmp_latest="$(ver_cmp "$LOCAL_VER" "$REMOTE_VER")"
	case "$cmp_latest" in
		0)
			LATEST_EFFECTIVE="$REMOTE_VER"
			log "effective latest version set to remote=$REMOTE_VER (remote newer)"
			;;
		1)
			LATEST_EFFECTIVE="$LOCAL_VER"
			log "effective latest version set to local=$LOCAL_VER (versions equal)"
			;;
		2)
			LATEST_EFFECTIVE="$LOCAL_VER"
			log "effective latest version set to local=$LOCAL_VER (local newer than remote)"
			;;
	esac
elif [ -n "$REMOTE_VER" ]; then
	LATEST_EFFECTIVE="$REMOTE_VER"
	log "effective latest version set to remote=$REMOTE_VER (local unknown)"
elif [ -n "$LOCAL_VER" ]; then
	LATEST_EFFECTIVE="$LOCAL_VER"
	log "effective latest version set to local=$LOCAL_VER (remote unknown)"
fi

if [ -n "$LATEST_EFFECTIVE" ]; then
	echo "$LATEST_EFFECTIVE" >"$LATEST_VER_FILE"
	echo "$LATEST_EFFECTIVE" >"$FW_LATEST_FILE"
fi

# если нет URL обновления — обновлять нечем
if [ -z "$UPDATE_URL" ]; then
	log "empty update_url, nothing to do"
	exit 0
fi

# --- минимальная версия (если указана) ---
if [ -n "$MIN_VER" ] && [ -n "$LOCAL_VER" ]; then
	cmp_min="$(ver_cmp "$LOCAL_VER" "$MIN_VER")"
	if [ "$cmp_min" -eq 0 ]; then
		log "local version below min_version (local=$LOCAL_VER, min=$MIN_VER)"
	fi
fi

# --- version check (если известна локальная версия) ---
if [ -n "$REMOTE_VER" ] && [ -n "$LOCAL_VER" ]; then
	cmp="$(ver_cmp "$LOCAL_VER" "$REMOTE_VER")"
	case "$cmp" in
		1)
			log "already up-to-date (local=$LOCAL_VER, remote=$REMOTE_VER)"
			exit 0
			;;
		2)
			log "local version newer than remote; skipping update (local=$LOCAL_VER, remote=$REMOTE_VER)"
			exit 0
			;;
		0)
			log "update required: local=$LOCAL_VER < remote=$REMOTE_VER"
			if [ "$CHECK_ONLY" = "1" ]; then
				log "CHECK_ONLY=1, skipping install (check mode)"
				# при check-mode уже обновили LATEST-файлы, этого достаточно
				exit 0
			fi
			;;
	esac
else
	log "one of versions is empty (local='${LOCAL_VER:-}', remote='${REMOTE_VER:-}'), will update anyway if URL is set"
fi

TMP_IPK="/tmp/${PKG_NAME}_update.ipk"

log "downloading update from: $UPDATE_URL"

if ! uclient-fetch -qO "$TMP_IPK" "$UPDATE_URL"; then
	log "download failed"
	rm -f "$TMP_IPK"
	exit 1
fi

# --- size check ---
if [ ! -s "$TMP_IPK" ]; then
	log "downloaded file is empty"
	rm -f "$TMP_IPK"
	exit 1
fi

# save old version
if [ -n "$LOCAL_VER" ]; then
	echo "$LOCAL_VER" >"$LOCAL_VER_PREV_FILE"
	log "previous version saved: $LOCAL_VER"
fi

log "installing update from $TMP_IPK"

if ! SHPUN_MANAGED_UPDATE=1 opkg install --force-reinstall "$TMP_IPK"; then
	log "opkg failed"
	rm -f "$TMP_IPK"
	exit 1
fi

rm -f "$TMP_IPK"

# write new version (во все имена файлов)
if [ -n "$REMOTE_VER" ]; then
	echo "$REMOTE_VER" >"$LOCAL_VER_FILE"
	echo "$REMOTE_VER" >"$LOCAL_VER_FILE_LEGACY"
	echo "$REMOTE_VER" >"$FW_CURRENT_FILE"
	echo "$REMOTE_VER" >"$LATEST_VER_FILE"
	echo "$REMOTE_VER" >"$FW_LATEST_FILE"
	log "local version updated to $REMOTE_VER"
fi

log "restart services; shpun-agent will start vpn after effective config validation"

/etc/init.d/shpun-agent stop  2>/dev/null || true
/etc/init.d/shpun-vpn stop    2>/dev/null || true
rm -f "$CONF_DIR/vpn_ready" "$CONF_DIR/xray_config_pending" "$CONF_DIR/dns_proxy_ready" 2>/dev/null || true

/etc/init.d/shpun-agent start 2>/dev/null || true

# rpcd reload is safe
/etc/init.d/rpcd restart 2>/dev/null || true

log "update finished OK"
exit 0
