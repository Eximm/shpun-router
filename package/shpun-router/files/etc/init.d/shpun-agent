#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034

START=95
STOP=10
USE_PROCD=1
SERVICE_DAEMONIZE=0

PROG="/etc/shpun/agent.sh"

start_service() {
	# During OTA, default_postinst starts every packaged init script. Defer the
	# single coordinated restart to router_updater after opkg has finished.
	[ "${SHPUN_MANAGED_UPDATE:-0}" = "1" ] && {
		logger -t shpun-agent "managed package update: start deferred to router_updater"
		return 0
	}

	# Не стартуем, если нет скрипта агента
	[ -x "$PROG" ] || {
		logger -t shpun-agent "Agent script not found or not executable: $PROG"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG"

	# Менее агрессивный respawn: не чаще раза в 60 секунд
	#   respawn <timeout> <max_retry> <retry_interval>
	#   timeout        – минимальный аптайм процесса, чтобы не считать падением
	#   max_retry      – макс. число рестартов за retry_interval
	#   retry_interval – окно времени в секундах
	procd_set_param respawn 60 5 300

	# Понижаем приоритет, чтобы агент не мешал маршрутизации/свитчу
	procd_set_param nice 10

	procd_close_instance
}

stop_service() {
	# procd сам корректно убьёт процесс
	:
}

reload_service() {
	# Для простоты: при reload просто перезапускаем агент,
	# чтобы он перечитал /etc/shpun/agent.conf, если его правили.
	stop
	start
}
