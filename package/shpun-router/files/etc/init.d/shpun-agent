#!/bin/sh /etc/rc.common
# shpun-agent — фоновый агент, который получает subscription_url и управляет VPN
# shellcheck disable=SC2034

START=95
STOP=10
USE_PROCD=1

PROG="/etc/shpun/agent.sh"

start_service() {
    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param respawn 300 5 0   # при падении: макс 5 рестартов, не чаще 1 раза в 300с
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # procd сам прибьёт процесс; спец-логика не нужна
    :
}
