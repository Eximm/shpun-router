#!/bin/sh /etc/rc.common
# shellcheck shell=sh
# shellcheck disable=SC2034

START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /etc/shpun/agent.sh
	procd_set_param respawn 5 10 0   # перезапуск при падении
	procd_set_param stdout 1         # логировать stdout в logread
	procd_set_param stderr 1         # логировать stderr в logread
	procd_close_instance
}
