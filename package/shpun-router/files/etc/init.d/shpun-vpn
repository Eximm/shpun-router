#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034

START=96
USE_PROCD=1
SERVICE_DAEMONIZE=0

CONF="/etc/shpun/agent.conf"

load_conf() {
	[ -f "$CONF" ] && . "$CONF"
}

start_service() {
	load_conf

	[ -z "$ENGINE_BIN" ] && return 1
	[ -z "$ENGINE_CONFIG" ] && return 1

	if [ ! -x "$ENGINE_BIN" ]; then
		echo "shpun-vpn: engine binary not found or not executable: $ENGINE_BIN" >&2
		return 1
	fi

	procd_open_instance
	procd_set_param command "$ENGINE_BIN" run -c "$ENGINE_CONFIG"
	procd_set_param respawn 300 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# можно просто убить по имени бинарника
	[ -n "$ENGINE_BIN" ] && procd_killall "$ENGINE_BIN"
}
