#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034

START=96
USE_PROCD=1
SERVICE_DAEMONIZE=0

CONF="/etc/shpun/agent.conf"

load_conf() {
    # shellcheck disable=SC1090,SC1091
    [ -f "$CONF" ] && . "$CONF"
}

start_service() {
    load_conf

    [ -z "$ENGINE_BIN" ] && return 0
    [ -z "$ENGINE_CONFIG" ] && return 0

    # если движка ещё нет — просто ждём, агент его докачает
    if [ ! -x "$ENGINE_BIN" ]; then
        logger -t shpun-vpn "engine binary not found yet: $ENGINE_BIN (waiting for shpun-agent)"
        return 0
    fi

    procd_open_instance

    # ⚡ Главное исправление — включаем поддержку legacy TUN API
    procd_set_param env ENABLE_DEPRECATED_TUN_ADDRESS_X=true

    procd_set_param command "$ENGINE_BIN" run -c "$ENGINE_CONFIG"
    procd_set_param respawn 300 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    :
}
