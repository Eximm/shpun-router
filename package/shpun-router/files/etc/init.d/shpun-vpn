#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034

START=96
USE_PROCD=1
SERVICE_DAEMONIZE=0

CONF="/etc/shpun/agent.conf"
LOG_TAG="shpun-vpn"

ENGINE_BIN="/tmp/xray"
ENGINE_CONFIG="/etc/shpun/xray.json"
DNS_SCRIPT="/etc/shpun/dns-xray.sh"
DNS_PROXY_READY_FILE="/etc/shpun/dns_proxy_ready"

TPROXY_MARK_DEFAULT=233
TPROXY_TABLE_DEFAULT=233

load_conf() {
    [ -f "$CONF" ] && . "$CONF"
    [ -z "$ENGINE_BIN" ]    && ENGINE_BIN="/tmp/xray"
    [ -z "$ENGINE_CONFIG" ] && ENGINE_CONFIG="/etc/shpun/xray.json"
    [ -z "$TPROXY_MARK" ]   && TPROXY_MARK="$TPROXY_MARK_DEFAULT"
    [ -z "$TPROXY_TABLE" ]  && TPROXY_TABLE="$TPROXY_TABLE_DEFAULT"
}

start_service() {
    load_conf

    if [ -z "$ENGINE_BIN" ] || [ -z "$ENGINE_CONFIG" ]; then
        logger -t "$LOG_TAG" "ENGINE_BIN or ENGINE_CONFIG is not set"
        return 1
    fi

    if [ ! -x "$ENGINE_BIN" ]; then
        logger -t "$LOG_TAG" "engine binary not found: $ENGINE_BIN (waiting for shpun-agent)"
        return 0
    fi

    if [ ! -s "$ENGINE_CONFIG" ]; then
        logger -t "$LOG_TAG" "engine config empty: $ENGINE_CONFIG (waiting for build-config.sh)"
        return 0
    fi

    if [ -x /etc/shpun/firewall-xray.sh ]; then
        /etc/shpun/firewall-xray.sh init || {
            logger -t "$LOG_TAG" "firewall-xray.sh init failed"
            return 1
        }
    else
        logger -t "$LOG_TAG" "firewall-xray.sh not found"
        return 1
    fi

    logger -t "$LOG_TAG" "starting xray: $ENGINE_BIN run -config $ENGINE_CONFIG"

    procd_open_instance
    procd_set_param command "$ENGINE_BIN" run -config "$ENGINE_CONFIG"
    procd_set_param respawn 60 5 300
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

}

stop_service() {
    load_conf
    logger -t "$LOG_TAG" "stopping xray"
    rm -f "$DNS_PROXY_READY_FILE"

    if [ -x "$DNS_SCRIPT" ]; then
        "$DNS_SCRIPT" clear || logger -t "$LOG_TAG" "dns-xray.sh clear failed"
    fi

    if [ -x /etc/shpun/firewall-xray.sh ]; then
        /etc/shpun/firewall-xray.sh stop
    fi
}
