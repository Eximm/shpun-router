#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034

START=96
USE_PROCD=1
SERVICE_DAEMONIZE=0

CONF="/etc/shpun/agent.conf"

load_conf() {
    # shellcheck disable=SC1090,SC1091
    [ -f "$CONF" ] && . "$CONF"

    # значения по умолчанию, если в конфиге не заданы
    [ -z "$ENGINE_BIN" ]    && ENGINE_BIN="/tmp/xray"
    [ -z "$ENGINE_CONFIG" ] && ENGINE_CONFIG="/etc/shpun/xray.json"
}

start_service() {
    load_conf

    # минимальная валидация конфигурации
    if [ -z "$ENGINE_BIN" ] || [ -z "$ENGINE_CONFIG" ]; then
        logger -t shpun-vpn "ENGINE_BIN or ENGINE_CONFIG is not set, nothing to start"
        return 1
    fi

    if [ ! -x "$ENGINE_BIN" ]; then
        logger -t shpun-vpn "engine binary not found or not executable: $ENGINE_BIN (waiting for shpun-agent)"
        return 0
    fi

    if [ ! -s "$ENGINE_CONFIG" ]; then
        logger -t shpun-vpn "engine config not found or empty: $ENGINE_CONFIG (waiting for build-config.sh)"
        return 0
    fi

    procd_open_instance

    # Xray: стандартный запуск "-c <file>"
    procd_set_param command "$ENGINE_BIN" -c "$ENGINE_CONFIG"
    # respawn: (черед пауза) (макс. пауза) (макс. попыток, 0 = бесконечно)
    procd_set_param respawn 5 10 0
    procd_set_param stdout 1
    procd_set_param stderr 1

    procd_close_instance

    # После запуска Xray накатываем правила firewall (прозрачный редирект)
    [ -x /etc/shpun/firewall-xray.sh ] && /etc/shpun/firewall-xray.sh
}

stop_service() {
    # procd сам убьёт процесс инстанса
    :
}

reload_service() {
    # чтобы "service shpun-vpn reload" обновлял конфиг и правила
    stop
    start
}
