#!/bin/sh /etc/rc.common
# shpun-vpn — запускает VPN-движок (sing-box/xray/другой) с конфигом из /etc/shpun
# shellcheck shell=sh
# shellcheck disable=SC2034  # START/STOP/USE_PROCD используются фреймворком /etc/rc.common

START=60
STOP=20
USE_PROCD=1

CONF="/etc/shpun/agent.conf"

log() {
    logger -t shpun-vpn "$*"
}

load_conf() {
    [ -f "$CONF" ] || { log "config $CONF not found"; return 1; }
    # shellcheck disable=SC1090
    . "$CONF"

    : "${ENGINE_NAME:=sing-box}"
    : "${ENGINE_BIN:=/usr/bin/sing-box}"
    : "${ENGINE_CONFIG:=/etc/shpun/sing-box.json}"
}

start_service() {
    load_conf || return 1

    if [ ! -x "$ENGINE_BIN" ]; then
        log "engine binary not found or not executable: $ENGINE_BIN"
        return 1
    fi

    if [ ! -f "$ENGINE_CONFIG" ]; then
        log "engine config not found: $ENGINE_CONFIG"
        return 1
    fi

    log "starting $ENGINE_NAME with config $ENGINE_CONFIG"

    procd_open_instance
    # для sing-box: run -c /path/to/config
    procd_set_param command "$ENGINE_BIN" run -c "$ENGINE_CONFIG"
    # respawn: через 10 секунд, не чаще 5 раз подряд
    procd_set_param respawn 10 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    load_conf || true
    log "stopping ${ENGINE_NAME:-engine}"
    # procd сам убьёт процесс, тут ничего делать не нужно
    :
}
