#!/bin/sh /etc/rc.common
# shpun-vpn — запускает движок (sing-box/xray) с конфигом из /etc/shpun
# shellcheck disable=SC2034



START=60
STOP=20
USE_PROCD=1

CONF="/etc/shpun/agent.conf"

load_conf() {
    [ -f "$CONF" ] || return 1
    # shellcheck disable=SC1090
    . "$CONF"

    : "${ENGINE_BIN:=/usr/bin/sing-box}"
    : "${ENGINE_CONFIG:=/etc/shpun/sing-box.json}"
}

start_service() {
    load_conf || {
        echo "shpun-vpn: no $CONF"
        return 1
    }

    procd_open_instance
    # для sing-box: run -c /path/to/config
    procd_set_param command "$ENGINE_BIN" run -c "$ENGINE_CONFIG"
    procd_set_param respawn 300 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # procd сам убьёт процесс
    :
}
