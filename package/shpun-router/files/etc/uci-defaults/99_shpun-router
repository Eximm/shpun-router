#!/bin/sh

# ==========================
# 1. Зарегистрировать ucode backend shpun в rpcd
# ==========================
uci -q delete rpcd.shpun
uci set rpcd.shpun='ucode'
uci set rpcd.shpun.script='/usr/share/rpcd/ucode/shpun.uc'
uci set rpcd.shpun.acl='shpun'
uci commit rpcd

# ==========================
# 2. Почистить старый интерфейс network.vpn (tun0) от старых версий пакета
# ==========================
if [ "$(uci -q get network.vpn.ifname)" = "tun0" ] && \
   [ "$(uci -q get network.vpn.proto)" = "none" ]; then
    uci -q delete network.vpn
    uci commit network
fi

# В новой Xray-схеме мы не создаём tun0 и network.vpn — работаем через
# прозрачный dokodemo-door + iptables REDIRECT.

# ==========================
# 3. Отключить IPv6 на LAN/WAN + DHCPv6/RA (минимум лишней нагрузки)
# ==========================

# LAN/WAN: выключить IPv6
if uci -q get network.lan >/dev/null 2>&1; then
    uci set network.lan.ipv6='0'
fi
if uci -q get network.wan >/dev/null 2>&1; then
    uci set network.wan.ipv6='0'
fi

# DHCP/RA: LAN
if uci -q get dhcp.lan >/dev/null 2>&1; then
    uci set dhcp.lan.dhcpv6='disabled'
    uci set dhcp.lan.ra='disabled'
    uci set dhcp.lan.ndp='disabled'
fi

# DHCP/RA: WAN
if uci -q get dhcp.wan >/dev/null 2>&1; then
    uci set dhcp.wan.dhcpv6='disabled'
    uci set dhcp.wan.ra='disabled'
    uci set dhcp.wan.ndp='disabled'
fi

uci commit dhcp
uci commit network

# ==========================
# 4. Убедиться, что dnsmasq читает /etc/dnsmasq.d
# ==========================
if uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1; then
    uci set dhcp.@dnsmasq[0].confdir='/etc/dnsmasq.d'
    uci commit dhcp
fi

# ==========================
# 5. Добавить вызов shpun-firewall-xray в /etc/firewall.user
# ==========================
if ! grep -q "shpun-firewall-xray" /etc/firewall.user 2>/dev/null; then
    cat >> /etc/firewall.user << 'EOF'

# --- shpun-firewall-xray ---
[ -x /etc/shpun/firewall-xray.sh ] && /etc/shpun/firewall-xray.sh
# --- end shpun-firewall-xray ---
EOF
fi

# ==========================
# 6. Отложенные рестарты (rpcd, network, firewall, dnsmasq)
#    чтобы не рвать LuCI при установке пакета
# ==========================

(
    sleep 5
    /etc/init.d/rpcd restart >/dev/null 2>&1 || true
    /etc/init.d/network restart >/dev/null 2>&1 || true
    /etc/init.d/firewall restart >/dev/null 2>&1 || true
    /etc/init.d/dnsmasq restart >/dev/null 2>&1 || true
) &

# ==========================
# 7. Удаляем себя
# ==========================
rm -f /etc/uci-defaults/99_shpun-router

exit 0
