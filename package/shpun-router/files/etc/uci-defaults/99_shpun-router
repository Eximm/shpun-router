#!/bin/sh

# ==========================
# 1. Зарегистрировать ucode backend shpun в rpcd
# ==========================
uci -q delete rpcd.shpun
uci set rpcd.shpun='ucode'
uci set rpcd.shpun.script='/usr/share/rpcd/ucode/shpun.uc'
uci set rpcd.shpun.acl='shpun'
uci commit rpcd

# ==========================
# 2. Почистить старый интерфейс network.vpn (tun0) от старых версий пакета
# ==========================
NETWORK_CHANGED=0
if [ "$(uci -q get network.vpn.ifname)" = "tun0" ] && \
   [ "$(uci -q get network.vpn.proto)" = "none" ]; then
    uci -q delete network.vpn
    uci commit network
    NETWORK_CHANGED=1
fi

# В новой Xray-схеме мы не создаём tun0 и network.vpn — работаем через
# прозрачный dokodemo-door + nftables REDIRECT.

# ==========================
# 3. Инициализация routing state
# ==========================
mkdir -p /etc/shpun/routes 2>/dev/null || true
[ -f /etc/shpun/routes/mode ] || echo "full" > /etc/shpun/routes/mode
[ -f /etc/shpun/routes/ru.version ] || echo "0" > /etc/shpun/routes/ru.version
[ -f /etc/shpun/routes/last_check ] || echo "0" > /etc/shpun/routes/last_check
[ -f /etc/shpun/routes/ru.sha256 ] || : > /etc/shpun/routes/ru.sha256
[ -f /etc/shpun/routes/ru.cidrs ] || : > /etc/shpun/routes/ru.cidrs

# ==========================
# 3.5. Persistent server-auto-select state (idempotent; never overwrites)
# ==========================
# server_auto_select: 0|1 — user toggle for automatic server failover.
# server_auto_exclude_ru: 0|1 — strict RU exclusion from automatic failover.
# Both files are created only if missing. AUTO_FAILOVER_ENABLE remains a
# separate administrative override; the agreed user-toggle default is enabled.
[ -f /etc/shpun/server_auto_select ]    || echo "1" > /etc/shpun/server_auto_select 2>/dev/null || true
[ -f /etc/shpun/server_auto_exclude_ru ] || echo "1" > /etc/shpun/server_auto_exclude_ru 2>/dev/null || true

# ==========================
# 4. Отключить стандартное уведомление attended sysupgrade при входе
# ==========================
# Обновления Shpun показываются своим OTA-виджетом. В некоторых сборках LuCI
# штатное уведомление падает с "_(...).format is not a function".
if uci -q get attendedsysupgrade.client >/dev/null 2>&1; then
    uci set attendedsysupgrade.client.login_check_for_upgrades='0'
    uci commit attendedsysupgrade
fi

# ==========================
# 5. Отложенная активация rpcd и очистки старой сети
# ==========================
(
    sleep 5
    /etc/init.d/rpcd restart >/dev/null 2>&1 || true
    [ "$NETWORK_CHANGED" = "1" ] && /etc/init.d/network reload >/dev/null 2>&1 || true
) &

# ==========================
# 6. Удаляем себя
# ==========================
rm -f /etc/uci-defaults/99_shpun-router

exit 0
